# Môi trường ảo Python
.venv/

# Byte-code Python (không commit)
__pycache__/
*.pyc

# Thư mục làm việc của công cụ hỗ trợ
.freebuff/

# Dữ liệu chạy: chứa khoá riêng Ed25519 của server và băm mật khẩu người dùng -> KHÔNG commit
server_data/
client_state*/

# Trạng thái cục bộ của graphify (chứa đường dẫn tuyệt đối của máy, không commit).
# Dùng **/ vì graphify được chạy trong source/ nên đầu ra nằm ở source/graphify-out/.
**/graphify-out/.graphify_build_state.json
**/graphify-out/.graphify_labels.json.sig
**/graphify-out/.graphify_labels.pending.json
**/graphify-out/cache/stat-index.json
**/graphify-out/.rebuild.lock
**/graphify-out/.graph.html.stale

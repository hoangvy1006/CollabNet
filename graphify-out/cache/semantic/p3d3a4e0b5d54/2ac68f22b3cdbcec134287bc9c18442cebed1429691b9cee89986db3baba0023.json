{"nodes": [{"id": "source_code_readme_collabnet", "label": "CollabNet", "file_type": "document", "source_file": "Source Code/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chat with broadcast and private messages, an online user list, and reliable file transfer, all on raw UDP with a handwritten multi-stream transport and AES-256-GCM. The UI is HTML and JavaScript served by a handwritten HTTP server."}, {"id": "source_code_readme_custom_udp_transport", "label": "Custom UDP Transport", "file_type": "rationale", "source_file": "Source Code/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Messaging must be reliable, so the application does not use TCP between hosts. A QUIC-like transport on raw UDP provides multiple streams, a sliding window, ACK/SACK, selective retransmit, and a choice of CUBIC or BBR."}, {"id": "source_code_readme_aes_256_gcm", "label": "AES-256-GCM", "file_type": "concept", "source_file": "Source Code/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "source_code_readme_cryptography", "label": "cryptography library", "file_type": "concept", "source_file": "Source Code/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only third-party library. It supplies AES-GCM, X25519, and Ed25519. Python 3.10+ (tried on 3.12) is the runtime, on Windows, macOS, or Linux."}, {"id": "source_code_readme_web_ui", "label": "Web UI", "file_type": "concept", "source_file": "Source Code/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The header shows the congestion-control algorithm, RTT, congestion window, and loss in real time. Everyone is the broadcast room; selecting a person sends a private message. Files are sent only to one person, via the paperclip or drag-and-drop."}, {"id": "source_code_readme_server_server", "label": "server.server entry point", "file_type": "concept", "source_file": "Source Code/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "source_code_readme_ed25519_fingerprint", "label": "Ed25519 identity fingerprint", "file_type": "concept", "source_file": "Source Code/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "source_code_readme_server_data", "label": "server_data directory", "file_type": "concept", "source_file": "Source Code/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "source_code_readme_cubic", "label": "CUBIC", "file_type": "concept", "source_file": "Source Code/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "source_code_readme_bbr", "label": "BBR", "file_type": "concept", "source_file": "Source Code/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "source_code_readme_client_main", "label": "client.main entry point", "file_type": "concept", "source_file": "Source Code/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "source_code_readme_tofu", "label": "TOFU server-key pinning", "file_type": "rationale", "source_file": "Source Code/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On the first connection the client pins the server fingerprint. If the key changes, the client refuses the connection to stop a man-in-the-middle. Trusting a new key means deleting that entry from known_hosts.json."}, {"id": "source_code_readme_known_hosts_json", "label": "known_hosts.json", "file_type": "concept", "source_file": "Source Code/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "source_code_readme_lan_beacon", "label": "LAN UDP beacon discovery", "file_type": "concept", "source_file": "Source Code/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A server UDP broadcast beacon lets the UI button Tim trong LAN find the server. Otherwise the client is pointed at host:port, including a LAN IP."}, {"id": "source_code_readme_client_state", "label": "client_state directory", "file_type": "concept", "source_file": "Source Code/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "source_code_readme_network_simulation", "label": "Loss and delay simulation", "file_type": "concept", "source_file": "Source Code/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "source_code_readme_unittest_suite", "label": "Unittest suite", "file_type": "concept", "source_file": "Source Code/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "python -m unittest discover -s tests -t . -v runs 19 tests and takes about 45 seconds."}, {"id": "source_code_readme_benchmark", "label": "CUBIC versus BBR benchmark", "file_type": "concept", "source_file": "Source Code/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "source_code_readme_build_report_py", "label": "docs/build_report.py", "file_type": "concept", "source_file": "Source Code/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Regenerates docs/report.pdf and needs reportlab and matplotlib."}, {"id": "source_code_readme_common_transport_py", "label": "common/transport.py", "file_type": "concept", "source_file": "Source Code/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Connection and Endpoint: streams, ACK/SACK, loss recovery, flow control, and the handshake."}, {"id": "source_code_readme_common_congestion_py", "label": "common/congestion.py", "file_type": "concept", "source_file": "Source Code/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "source_code_readme_common_crypto_py", "label": "common/crypto.py", "file_type": "concept", "source_file": "Source Code/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "X25519, Ed25519, HKDF, AES-GCM, and PBKDF2."}, {"id": "source_code_readme_common_packet_py", "label": "common/packet.py", "file_type": "concept", "source_file": "Source Code/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "source_code_readme_common_protocol_py", "label": "common/protocol.py", "file_type": "concept", "source_file": "Source Code/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Application messages are length-prefixed JSON."}, {"id": "source_code_readme_common_discovery_py", "label": "common/discovery.py", "file_type": "concept", "source_file": "Source Code/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "source_code_readme_server_server_py", "label": "server/server.py", "file_type": "concept", "source_file": "Source Code/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Authentication, presence, routing, and file relay. Connected users are tracked as Session and PEERS, including IP and port."}, {"id": "source_code_readme_client_core_py", "label": "client/core.py", "file_type": "concept", "source_file": "Source Code/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "source_code_readme_client_gateway_py", "label": "client/gateway.py", "file_type": "concept", "source_file": "Source Code/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Handwritten HTTP and SSE server on raw TCP, because the browser is not given a high-level web framework."}, {"id": "source_code_readme_per_message_stream", "label": "Per-message stream routing", "file_type": "rationale", "source_file": "Source Code/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each chat message is its own stream, broadcast or unicast through _route_msg, so a large transfer does not head-of-line block time-sensitive messages. Async I/O uses asyncio and add_reader on a raw UDP socket."}, {"id": "source_code_readme_reliable_file_transfer", "label": "Reliable chunked file transfer", "file_type": "concept", "source_file": "Source Code/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SendStream and RecvStream carry FILE and FILE_END chunks that are reassembled and checked with SHA-256."}, {"id": "source_code_readme_connection_resilience", "label": "Connection resilience", "file_type": "concept", "source_file": "Source Code/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PTO, idle timeout, and keep-alive, plus automatic reconnect and CLOSE, cover timeout, abrupt disconnect, and a clean exit."}, {"id": "source_code_readme_requirement_traceability", "label": "Assignment step traceability table", "file_type": "document", "source_file": "Source Code/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The README maps the ten assignment steps onto this UDP design: protocol docs plus packet.py and protocol.py; handshake as Endpoint.connect and _on_initial with INITIAL, HANDSHAKE, and AUTH_OK; Session and PEERS; asyncio; per-message streams; FILE and FILE_END with SHA-256; PTO and reconnect; AES-256-GCM with X25519 and Ed25519; client/web; and 19 tests plus loss and delay simulation."}, {"id": "source_code_readme_session_and_peers", "label": "Session and PEERS", "file_type": "concept", "source_file": "Source Code/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "source_code_readme_collabnet", "target": "source_code_readme_custom_udp_transport", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Source Code/README.md", "source_location": null, "weight": 1.0}, {"source": "source_code_readme_collabnet", "target": "source_code_readme_aes_256_gcm", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Source Code/README.md", "source_location": null, "weight": 1.0}, {"source": "source_code_readme_collabnet", "target": "source_code_readme_web_ui", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Source Code/README.md", "source_location": null, "weight": 1.0}, {"source": "source_code_readme_collabnet", "target": "source_code_readme_cryptography", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Source Code/README.md", "source_location": null, "weight": 1.0}, {"source": "source_code_readme_custom_udp_transport", "ta